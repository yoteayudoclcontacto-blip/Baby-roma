# Shopify Storefront API (public, read-only — safe for a headless frontend)
# Domain WITHOUT protocol, e.g. yoteayudo-6462.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your-storefront-api-token
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Base URL of this site (used for SEO metadata + JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.yoteayudo.cl

# NOTE: the Shopify Admin API token is intentionally NOT used by this app.
# A headless storefront only ever needs the Storefront API (public, read-scoped
# to products/collections/checkout). Never expose an Admin API token to a
# frontend project or commit it to source control.
